# The style the files are already in. A full formatter would rewrite
# most lines of the repo, so this only holds the basics.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# a Windows batch file is read by cmd.exe
[*.cmd]
end_of_line = crlf

[*.{png,jpg,gif,ico,woff2,wasm,pbf,mp4}]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
